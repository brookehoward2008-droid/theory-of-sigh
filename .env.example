# Adobe Firefly Services - InDesign API credentials.
# Copy this file to `.env` and fill in the values from your Adobe Developer
# Console project (Firefly Services / InDesign API credential).
# NEVER commit the filled-in `.env` (it is gitignored).

# Client ID (also sent as the x-api-key header). Required.
ADOBE_CLIENT_ID=

# Client secret, used to mint a server-to-server access token via Adobe IMS.
# Required UNLESS you supply ADOBE_ACCESS_TOKEN below.
ADOBE_CLIENT_SECRET=

# Optional: paste a pre-minted access token to skip the IMS exchange (handy for
# a one-off test). Leave blank to mint tokens automatically from the secret.
ADOBE_ACCESS_TOKEN=

# Optional overrides — defaults are correct for most Firefly Services projects.
# Use the exact scopes shown on your Developer Console credential page.
# ADOBE_SCOPES=openid,AdobeID,read_organizations,firefly_api,ff_apis
# ADOBE_IMS_TOKEN_URL=https://ims-na1.adobelogin.com/ims/token/v3
# INDESIGN_API_BASE=https://indesign.adobe.io
